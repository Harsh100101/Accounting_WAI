# ==========================================
# AI-Powered Investment Lens - .gitignore
# ==========================================

# Environment & Secrets (CRITICAL: Do NOT commit secrets)
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
*.env
!*.env.example

# Sensitive Credential & Key Files
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
id_ed25519*
service-account*.json
credentials*.json
secret*.json
*.keystore

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js Build & Runtime Outputs
.next/
out/
build/
dist/
.turbo/
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic & Cache
.cache/
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Temporary / Scratch Files
scratch/
.system_generated/
*.tmp
*.temp
